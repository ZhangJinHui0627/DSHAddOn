{
  "name": "local-token-ledger",
  "version": "1.1.0",
  "description": "Native token usage ledger and price estimation plugin for DSH Go mobile app.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "dsh-go-plugin",
    "deepseek-harness"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "token-prices.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dshGo": {
    "v": 1,
    "minApp": "1.0.9",
    "title": {
      "zh": "Token 总账",
      "en": "Token ledger"
    },
    "icon": "chart",
    "contributes": {
      "composer.strip": [
        {
          "id": "ledger-strip",
          "icon": "chart",
          "text": {
            "zh": "累计 — · 估算 —",
            "en": "All — · Est —"
          },
          "panel": "ledger-panel"
        }
      ],
      "panels": [
        {
          "id": "ledger-panel",
          "title": {
            "zh": "Token 总账",
            "en": "Token ledger"
          },
          "icon": "chart",
          "placement": [
            "session.tab",
            "features"
          ]
        }
      ]
    }
  }
}
