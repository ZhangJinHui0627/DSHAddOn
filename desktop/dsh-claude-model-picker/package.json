{
  "name": "dsh-claude-model-picker",
  "version": "1.0.0",
  "description": "Claude Code 风格的模型选择器：座位触发器、分组模型列表（倍率徽章与说明）、搜索、推理等级。移植自 Nwflower/dsh-claude-style 的选择器部分。",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "model-picker",
    "claude-style"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "data/model-descriptions.json",
    "data/prices.json",
    "README.md",
    "package.json"
  ]
}
