{
  "name": "dsh-status-badges",
  "version": "1.4.1",
  "description": "五个对话顶栏状态徽章合为一个插件：Antigravity 额度、千问代金券、WorkBuddy 积分（国内/国际双区）、Codex 额度、ZCode 账号池按模型聚合额度，每个可单独开关。",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "badge",
    "header"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "package.json"
  ]
}
